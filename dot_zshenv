# Preset definitions — zsh syntax
typeset -A WORKTREE_PRESETS
WORKTREE_PRESETS=(
    [loyalty]="idl/code.uber.internal/product/earner_rewards src/code.uber.internal/product/earner_rewards"
    [payments]="idl/code.uber.internal/product/payments src/code.uber.internal/product/payments"
    [infra]="src/code.uber.internal/infra/some-lib src/code.uber.internal/infra/other-lib"
    [capri]="src/code.uber.internal/marketplace/platform/capri src/code.uber.internal/marketplace/platform/capri-inspector src/code.uber.internal/marketplace/platform/capri-validator"
)
local GITBZL=~/go-code/bin/git-bzl

worktree() {
    local preset=$1
    local suffix=$2
    local branch=$3

    if [[ -z "$preset" || -z "$branch" ]]; then
        echo "Usage: worktree <preset> <suffix> <branch_name>"
        echo "Available presets: ${(k)WORKTREE_PRESETS}"
        return 1
    fi

    if [[ -z "${WORKTREE_PRESETS[$preset]}" ]]; then
        echo "Error: unknown preset '$preset'"
        echo "Available presets: ${(k)WORKTREE_PRESETS}"
        return 1
    fi

    local dest=~/go-code-$suffix

    cd ~/go-code || return 1
    $GITBZL new ~/go-code "$dest"
    cd "$dest" || return 1

    arh feature "$branch" || return 1

    # Split paths and add each one
    local paths=("${(s/ /)WORKTREE_PRESETS[$preset]}")
    for target_path in $paths; do
        echo "Adding: $target_path"
        $GITBZL add "$target_path"
    done

    echo ""
    echo "✓ Worktree ready at $dest (branch: $branch, preset: $preset, suffix: $suffix)"
}


typeset -A AI_PRESETS
AI_PRESETS=(
  [codex]="aifx agent run codex --yolo"
  # Add more here: [web]="npm run start"
)

function aisplit() {
  # 1. Ensure we are actually inside a tmux session
  if [[ -z "$TMUX" ]]; then
    echo "Error: Not inside a tmux session."
    return 1
  fi

  # 2. Check if an argument was provided at all
  if [[ -z "$1" ]]; then
    echo "Usage: tsplit <preset>"
    echo "Available presets: ${(k)AI_PRESETS}"
    return 1
  fi

  local ai=$1

  # 3. Check if the preset exists in the array
  if [[ -z "${AI_PRESETS[$ai]}" ]]; then
    echo "Error: unknown preset '$ai'"
    echo "Available presets: ${(k)AI_PRESETS}"
    return 1
  fi

  local cmd="${AI_PRESETS[$ai]}"

  # 4. Split the window horizontally
  tmux split-window -h -p 30

  # 5. Send the command to the left pane
  tmux send-keys -t '{last}' "$cmd" C-m
}
